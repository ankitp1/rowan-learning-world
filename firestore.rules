rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: families
// Document ID: {syncCode} (high-entropy unguessable family sync code, 8-32 alphanumeric/underscore/hyphen characters: ^[A-Za-z0-9_-]{8,32}$)
// Fields:
//   - db: string (required, 2 to 900,000 chars) - JSON-serialized DB state of the family learning world
//   - updatedAt: number (required, > 0) - epoch timestamp in ms when the state was last updated
//   - updatedBy: string (required, 1 to 64 chars) - device identifier that pushed the update
//   - version: number (required, must equal 1) - schema version of the synced payload
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate that the syncCode document ID is a valid 8-32 char token
    function isValidSyncCode(syncCode) {
      return syncCode is string &&
        syncCode.matches('^[A-Za-z0-9_-]{8,32}$');
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidFamilySyncDoc(data) {
      return hasRequiredFields(['db', 'updatedAt', 'updatedBy', 'version']) &&
        hasOnlyAllowedFields(['db', 'updatedAt', 'updatedBy', 'version']) &&
        data.db is string &&
        data.db.size() >= 2 &&
        data.db.size() <= 900000 &&
        data.updatedAt is number &&
        data.updatedAt > 0 &&
        data.updatedBy is string &&
        data.updatedBy.size() >= 1 &&
        data.updatedBy.size() <= 64 &&
        data.version is number &&
        data.version == 1;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /families/{syncCode} {
      // Disallow collection queries / enumeration of family sync codes
      allow list: if false;

      // Allow fetching/subscribing to a single family document only when knowing the valid syncCode
      allow get: if isValidSyncCode(syncCode);

      // Validate schema, types, and size bounds on both create and update
      allow create: if isValidSyncCode(syncCode) && isValidFamilySyncDoc(request.resource.data);
      allow update: if isValidSyncCode(syncCode) && isValidFamilySyncDoc(request.resource.data);

      // Disallow deletion of family state documents
      allow delete: if false;
    }

    // Default deny all other collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
